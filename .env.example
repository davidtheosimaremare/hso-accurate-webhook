# Environment Variables untuk HSO Accurate Webhook Server
# Copy file ini ke .env dan isi nilainya

# ============================
# SUPABASE
# ============================
SUPABASE_URL=https://frmcfdelyznzpyctiugm.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ============================
# ACCURATE ONLINE API
# ============================
ACCURATE_BASE_URL=https://account.accurate.id
ACCURATE_DB_ID=your-accurate-db-id
ACCURATE_SESSION=your-accurate-session-token
# Token untuk verifikasi bahwa webhook benar-benar dari Accurate
ACCURATE_WEBHOOK_SECRET=your-webhook-secret-key

# ============================
# SERVER
# ============================
PORT=3001
WEBHOOK_SECRET=random-secret-untuk-keamanan-internal

# ============================
# SYNC CONFIG
# ============================
# Berapa halaman data yang di-pull saat full sync (per dokumen)
SYNC_PAGE_SIZE=50
# Berapa hari ke belakang untuk full sync
SYNC_DAYS_BACK=30
